# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Executive narrative and Q&A via Amazon Bedrock ------------------------
# Credentials are NOT set here. The AWS SDK reads ~/.aws/credentials automatically
# (run `aws configure`), so copying a live secret into a second file buys nothing.
# Set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY only if you have no shared config.
#
# Without any credentials the narrative panel composes its summary from the same
# computed figures using deterministic rules — the page works fully either way.

AWS_REGION=us-east-1

# Which model writes the narrative. Two families, two APIs, picked by the id:
#   amazon.nova-*  Amazon's own models via the Converse API. Work on any account
#                  with Bedrock enabled. Verified: nova-pro, nova-lite, nova-micro,
#                  and us.amazon.nova-2-lite-v1:0.
#   anthropic.*    Claude via the Anthropic Bedrock SDK. A third-party marketplace
#                  model, so it ALSO needs a valid payment instrument on the AWS
#                  account — without one every call returns
#                  403 INVALID_PAYMENT_INSTRUMENT, whatever the model access grants say.
#
# Run `npm run bedrock:check` to see which models this account can actually invoke.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# --- Hosting ---------------------------------------------------------------
# Writable state (imported extracts, generated packs, cached narratives). Defaults to ./data.
# Point this at a mounted disk when deploying so state survives restarts.
# DATA_DIR=/var/data

# Set to 1 to start empty instead of loading the delivered extracts from
# Claude_Data/ on a cold start.
# SKIP_BOOTSTRAP_DATA=1
